  consumptionType      String?   @default("none") @map("consumption_type")
  consumedAt           DateTime? @map("consumed_at")
  consumedBy           String?   @map("consumed_by")
  consumedResourceId   String?   @map("consumed_resource_id")
  consumedResourceType String?   @map("consumed_resource_type")

  /// Local→VPS sync state
  syncStatus  String    @default("local_only") @map("sync_status")
  remoteId    String?   @map("remote_id")
  lastSyncAt  DateTime? @map("last_sync_at")
  syncError   String?   @map("sync_error") @db.Text
  syncVersion String?   @map("sync_version")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  mission               AgentMission?          @relation(fields: [missionId], references: [id], onDelete: SetNull)
  missionRun            AgentMissionRun?       @relation(fields: [missionRunId], references: [id], onDelete: SetNull)
  source                AgentSource            @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  scannedContent        ScannedContent         @relation(fields: [scannedContentId], references: [id], onDelete: Restrict)
  duplicateOf           AgentFinding?          @relation("FindingDuplicates", fields: [duplicateOfFindingId], references: [id], onDelete: SetNull)
  duplicates            AgentFinding[]         @relation("FindingDuplicates")
  notifications         AgentNotification[]
  actionProposals       AgentActionProposal[]
  externalInventoryItem ExternalInventoryItem? @relation(fields: [externalInventoryItemId], references: [id], onDelete: SetNull)
  workflowSteps         AgentWorkflowStepRun[]

  @@unique([scannedContentId, type])
  @@index([companyId])
  @@index([status, score])
  @@index([sourceId, createdAt])
  @@index([missionId, createdAt])
  @@index([missionRunId])
  @@index([promotedLeadId])
  @@index([companyId, status, createdAt])
  @@index([companyId, classification, status])
  @@index([companyId, finalScore])
  @@index([companyId, primaryPhone])
  @@index([companyId, primaryLocation])
  @@index([companyId, dedupeStatus])
  @@index([duplicateOfFindingId])
  @@index([externalInventoryItemId])
  @@index([scoreStatus])
  @@index([consumptionType, status])
  @@index([consumedResourceId])
  @@index([syncStatus])
  @@map("agent_findings")
}

