generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id
  data      Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("companies")
}

model User {
  id        String   @id
  email     String   @unique
  role      String
  companyId String?  @map("company_id")
  data      Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model CmsRecord {
  collection  String
  id          String
  companyId   String?  @map("company_id")
  ownerUserId String?  @map("owner_user_id")
  saleStatus  String?  @map("sale_status")
  status      String?
  data        Json
  searchText  String?  @map("search_text") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@id([collection, id])
  @@index([collection, companyId])
  @@index([collection, status])
  @@index([collection, saleStatus])
  @@map("cms_records")
}

model AppSetting {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model ChatHistory {
  id        String   @id
  userId    String   @map("user_id")
  companyId String?  @map("company_id")
  role      String
  message   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("chat_history")
}

model PublicChatGuest {
  sessionId  String   @id @map("session_id")
  name       String
  phone      String
  customerId String?  @map("customer_id")
  aiEnabled  Boolean  @default(true) @map("ai_enabled")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([updatedAt])
  @@map("public_chat_guests")
}

model GeneratedContent {
  id              String    @id
  companyId       String?   @map("company_id")
  userId          String?   @map("user_id")
  propertyId      String?   @map("property_id")
  propertyTitle   String?   @map("property_title")
  channel         String
  rawContent      String    @map("raw_content") @db.Text
  verifiedContent String?   @map("verified_content") @db.Text
  status          String    @default("raw")
  createdAt       DateTime  @default(now()) @map("created_at")
  verifiedAt      DateTime? @map("verified_at")

  @@index([companyId, channel])
  @@index([propertyId])
  @@index([status])
  @@map("generated_contents")
}

model Lead {
  id            String   @id
  name          String
  phone         String
  email         String?
  city          String?
  interestType  String?  @map("interest_type")
  budgetRange   String?  @map("budget_range")
  source        String?
  channel       String?
  utmSource     String?  @map("utm_source")
  utmMedium     String?  @map("utm_medium")
  utmCampaign   String?  @map("utm_campaign")
  pagePath      String?  @map("page_path")
  magnetSlug    String?  @map("magnet_slug")
  investorScore Int      @default(0) @map("investor_score")
  status        String   @default("new")
  accessToken   String?  @map("access_token")
  emailsSent    Int      @default(0) @map("emails_sent")
  createdAt     DateTime @map("created_at")
  updatedAt     DateTime @map("updated_at")

  scores  LeadScore[]
  sources LeadSource[]
  events  LeadEvent[]
  tags    LeadTag[]

  @@index([phone])
  @@index([investorScore])
  @@index([status])
  @@index([createdAt])
  @@map("leads")
}

model LeadScore {
  id         String   @id
  leadId     String   @map("lead_id")
  totalScore Int      @map("total_score")
  breakdown  Json
  createdAt  DateTime @map("created_at")
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_scores")
}

model LeadSource {
  id          String   @id
  leadId      String   @map("lead_id")
  channel     String?
  referrer    String?
  landingPage String?  @map("landing_page")
  utmSource   String?  @map("utm_source")
  utmMedium   String?  @map("utm_medium")
  utmCampaign String?  @map("utm_campaign")
  createdAt   DateTime @map("created_at")
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_sources")
}

model LeadEvent {
  id        String   @id
  leadId    String?  @map("lead_id")
  sessionId String?  @map("session_id")
  eventType String   @map("event_type")
  eventData Json?    @map("event_data")
  pagePath  String?  @map("page_path")
  createdAt DateTime @map("created_at")
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([eventType])
  @@index([leadId])
  @@index([sessionId])
  @@map("lead_events")
}

model LeadTag {
  id        String   @id
  leadId    String   @map("lead_id")
  tag       String
  createdAt DateTime @map("created_at")
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, tag])
  @@index([leadId])
  @@map("lead_tags")
}

model Author {
  id        String     @id
  name      String
  slug      String     @unique
  bio       String?    @db.Text
  avatarUrl String?    @map("avatar_url")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  posts     BlogPost[]

  @@map("authors")
}

model Category {
  id            String     @id
  name          String
  slug          String     @unique
  description   String?    @db.Text
  hubPath       String     @map("hub_path")
  legacyHubPath String?    @map("legacy_hub_path")
  sortOrder     Int        @default(0) @map("sort_order")
  isActive      Boolean    @default(true) @map("is_active")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  posts         BlogPost[]

  @@map("categories")
}

model Tag {
  id        String        @id
  name      String
  slug      String        @unique
  createdAt DateTime      @default(now()) @map("created_at")
  postTags  BlogPostTag[]

  @@map("tags")
}

model BlogPost {
  id                  String               @id
  title               String
  slug                String               @unique
  excerpt             String               @db.Text
  content             String               @db.Text
  contentMarkdown     String?              @map("content_markdown") @db.Text
  contentHtml         String?              @map("content_html") @db.Text
  metaTitle           String               @map("meta_title")
  metaDescription     String               @map("meta_description") @db.Text
  canonicalUrl        String?              @map("canonical_url")
  coverImage          String?              @map("cover_image")
  status              String               @default("draft")
  categoryId          String               @map("category_id")
  authorId            String               @map("author_id")
  publishedAt         DateTime?            @map("published_at")
  readingTime         Int?                 @map("reading_time")
  wordCount           Int?                 @map("word_count")
  seoScore            Int?                 @map("seo_score")
  contentQualityScore Int?                 @map("content_quality_score")
  sourceType          String               @default("manual") @map("source_type")
  primaryKeyword      String?              @map("primary_keyword")
  secondaryKeywords   Json?                @map("secondary_keywords")
  targetIntent        String?              @map("target_intent")
  cluster             String?
  articleType         String?              @map("article_type")
  isPillar            Boolean              @default(false) @map("is_pillar")
  isIndexable         Boolean              @default(true) @map("is_indexable")
  relatedSuggestions  Json?                @map("related_suggestions")
  relatedPostIds      Json?                @map("related_post_ids")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  category            Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  author              Author               @relation(fields: [authorId], references: [id], onDelete: Restrict)
  tags                BlogPostTag[]
  faqs                BlogPostFaq[]
  internalLinks       BlogPostInternalLink[]
  seoAudits           BlogPostSeoAudit[]
  revisions           BlogPostRevision[]
  aiDrafts            BlogPostAiDraft[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([sourceType])
  @@map("blog_posts")
}

model BlogPostTag {
  postId String   @map("post_id")
  tagId  String   @map("tag_id")
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("blog_post_tags")
}

model BlogPostFaq {
  id        String   @id
  postId    String   @map("post_id")
  question  String   @db.Text
  answer    String   @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("blog_post_faqs")
}

model BlogPostInternalLink {
  id        String   @id
  postId    String   @map("post_id")
  label     String
  href      String
  sortOrder Int      @default(0) @map("sort_order")
  isAuto    Boolean  @default(false) @map("is_auto")
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("blog_post_internal_links")
}

model BlogPostSeoAudit {
  id        String   @id
  postId    String   @map("post_id")
  passed    Boolean  @default(false)
  score     Int      @default(0)
  results   Json
  warnings  Json?
  errors    Json?
  createdAt DateTime @default(now()) @map("created_at")
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("blog_post_seo_audits")
}

model BlogPostRevision {
  id          String   @id
  postId      String   @map("post_id")
  snapshot    Json
  note        String?  @db.Text
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  post        BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("blog_post_revisions")
}

model BlogPostAiDraft {
  id           String    @id
  postId       String?   @map("post_id")
  status       String    @default("pending")
  input        Json
  outputMarkdown String? @map("output_markdown") @db.Text
  articleType  String?   @map("article_type")
  errorMessage String?   @map("error_message") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  post         BlogPost? @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("blog_post_ai_drafts")
}
