generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id
  data      Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("companies")
}

model User {
  id        String   @id
  email     String   @unique
  role      String
  companyId String?  @map("company_id")
  data      Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model CmsRecord {
  collection  String
  id          String
  companyId   String?  @map("company_id")
  ownerUserId String?  @map("owner_user_id")
  saleStatus  String?  @map("sale_status")
  status      String?
  data        Json
  searchText  String?  @map("search_text") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@id([collection, id])
  @@index([collection, companyId])
  @@index([collection, status])
  @@index([collection, saleStatus])
  @@map("cms_records")
}

model AppSetting {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model ChatHistory {
  id        String   @id
  userId    String   @map("user_id")
  companyId String?  @map("company_id")
  role      String
  message   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("chat_history")
}

model PublicChatGuest {
  sessionId  String   @id @map("session_id")
  name       String
  phone      String
  customerId String?  @map("customer_id")
  aiEnabled  Boolean  @default(true) @map("ai_enabled")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([updatedAt])
  @@map("public_chat_guests")
}

model GeneratedContent {
  id              String    @id
  companyId       String?   @map("company_id")
  userId          String?   @map("user_id")
  propertyId      String?   @map("property_id")
  propertyTitle   String?   @map("property_title")
  channel         String
  rawContent      String    @map("raw_content") @db.Text
  verifiedContent String?   @map("verified_content") @db.Text
  status          String    @default("raw")
  createdAt       DateTime  @default(now()) @map("created_at")
  verifiedAt      DateTime? @map("verified_at")

  @@index([companyId, channel])
  @@index([propertyId])
  @@index([status])
  @@map("generated_contents")
}

model Lead {
  id                     String    @id
  name                   String
  phone                  String
  email                  String?
  city                   String?
  interestType           String?   @map("interest_type")
  budgetRange            String?   @map("budget_range")
  source                 String?
  channel                String?
  utmSource              String?   @map("utm_source")
  utmMedium              String?   @map("utm_medium")
  utmCampaign            String?   @map("utm_campaign")
  pagePath               String?   @map("page_path")
  magnetSlug             String?   @map("magnet_slug")
  shortLinkSlug          String?   @map("short_link_slug")
  investorScore          Int       @default(0) @map("investor_score")
  status                 String    @default("new")
  accessToken            String?   @map("access_token")
  emailsSent             Int       @default(0) @map("emails_sent")
  facebookContactId      String?   @map("facebook_contact_id")
  facebookConversationId String?   @map("facebook_conversation_id")
  facebookPageId         String?   @map("facebook_page_id")
  sourceChannel          String?   @map("source_channel")
  sourceType             String?   @map("source_type")
  sourcePostId           String?   @map("source_post_id")
  sourceCommentId        String?   @map("source_comment_id")
  firstMessage           String?   @map("first_message") @db.Text
  /// Full structured promote payload (resolver detail)
  metadata               Json?
  findingId              String?   @map("finding_id")
  scannedContentId       String?   @map("scanned_content_id")
  priority               String?
  needSummary            String?   @map("need_summary") @db.Text
  facebookProfileUrl     String?   @map("facebook_profile_url") @db.Text
  secondaryPhones        Json?     @map("secondary_phones")
  preferredLocations     Json?     @map("preferred_locations")
  propertyTypes          Json?     @map("property_types")
  budgetMin              BigInt?   @map("budget_min")
  budgetMax              BigInt?   @map("budget_max")
  callCount              Int       @default(0) @map("call_count")
  lastCalledAt           DateTime? @map("last_called_at")
  lastCalledBy           String?   @map("last_called_by")
  callbackAt             DateTime? @map("callback_at")
  callNote               String?   @map("call_note") @db.Text
  convertedCustomerId    String?   @map("converted_customer_id")
  convertedAt            DateTime? @map("converted_at")
  convertedBy            String?   @map("converted_by")
  firstSeenAt            DateTime? @map("first_seen_at")
  lastSeenAt             DateTime? @map("last_seen_at")
  createdAt              DateTime  @map("created_at")
  updatedAt              DateTime  @map("updated_at")

  scores          LeadScore[]
  sources         LeadSource[]
  events          LeadEvent[]
  tags            LeadTag[]
  facebookContact FacebookContact? @relation(fields: [facebookContactId], references: [id], onDelete: SetNull)

  @@index([shortLinkSlug])
  @@index([phone])
  @@index([investorScore])
  @@index([status])
  @@index([createdAt])
  @@index([facebookContactId])
  @@index([sourceChannel])
  @@index([findingId])
  @@index([convertedCustomerId])
  @@index([callbackAt])
  @@map("leads")
}

model LeadScore {
  id         String   @id
  leadId     String   @map("lead_id")
  totalScore Int      @map("total_score")
  breakdown  Json
  createdAt  DateTime @map("created_at")
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_scores")
}

model LeadSource {
  id          String   @id
  leadId      String   @map("lead_id")
  channel     String?
  referrer    String?
  landingPage String?  @map("landing_page")
  utmSource   String?  @map("utm_source")
  utmMedium   String?  @map("utm_medium")
  utmCampaign String?  @map("utm_campaign")
  createdAt   DateTime @map("created_at")
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_sources")
}

model LeadEvent {
  id        String   @id
  leadId    String?  @map("lead_id")
  sessionId String?  @map("session_id")
  eventType String   @map("event_type")
  eventData Json?    @map("event_data")
  pagePath  String?  @map("page_path")
  createdAt DateTime @map("created_at")
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([eventType])
  @@index([leadId])
  @@index([sessionId])
  @@map("lead_events")
}

model LeadTag {
  id        String   @id
  leadId    String   @map("lead_id")
  tag       String
  createdAt DateTime @map("created_at")
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, tag])
  @@index([leadId])
  @@map("lead_tags")
}

model Author {
  id        String     @id
  name      String
  slug      String     @unique
  bio       String?    @db.Text
  avatarUrl String?    @map("avatar_url")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  posts     BlogPost[]

  @@map("authors")
}

model Category {
  id            String     @id
  name          String
  slug          String     @unique
  description   String?    @db.Text
  hubPath       String     @map("hub_path")
  legacyHubPath String?    @map("legacy_hub_path")
  sortOrder     Int        @default(0) @map("sort_order")
  isActive      Boolean    @default(true) @map("is_active")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  posts         BlogPost[]

  @@map("categories")
}

model Tag {
  id        String        @id
  name      String
  slug      String        @unique
  createdAt DateTime      @default(now()) @map("created_at")
  postTags  BlogPostTag[]

  @@map("tags")
}

model BlogPost {
  id                  String                 @id
  title               String
  slug                String                 @unique
  excerpt             String                 @db.Text
  content             String                 @db.Text
  contentMarkdown     String?                @map("content_markdown") @db.Text
  contentHtml         String?                @map("content_html") @db.Text
  metaTitle           String                 @map("meta_title")
  metaDescription     String                 @map("meta_description") @db.Text
  canonicalUrl        String?                @map("canonical_url")
  coverImage          String?                @map("cover_image")
  status              String                 @default("draft")
  categoryId          String                 @map("category_id")
  authorId            String                 @map("author_id")
  publishedAt         DateTime?              @map("published_at")
  readingTime         Int?                   @map("reading_time")
  wordCount           Int?                   @map("word_count")
  seoScore            Int?                   @map("seo_score")
  contentQualityScore Int?                   @map("content_quality_score")
  sourceType          String                 @default("manual") @map("source_type")
  primaryKeyword      String?                @map("primary_keyword")
  secondaryKeywords   Json?                  @map("secondary_keywords")
  targetIntent        String?                @map("target_intent")
  cluster             String?
  articleType         String?                @map("article_type")
  isPillar            Boolean                @default(false) @map("is_pillar")
  isIndexable         Boolean                @default(true) @map("is_indexable")
  relatedSuggestions  Json?                  @map("related_suggestions")
  relatedPostIds      Json?                  @map("related_post_ids")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  category            Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  author              Author                 @relation(fields: [authorId], references: [id], onDelete: Restrict)
  tags                BlogPostTag[]
  faqs                BlogPostFaq[]
  internalLinks       BlogPostInternalLink[]
  seoAudits           BlogPostSeoAudit[]
  revisions           BlogPostRevision[]
  aiDrafts            BlogPostAiDraft[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([sourceType])
  @@map("blog_posts")
}

model BlogPostTag {
  postId String   @map("post_id")
  tagId  String   @map("tag_id")
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("blog_post_tags")
}

model BlogPostFaq {
  id        String   @id
  postId    String   @map("post_id")
  question  String   @db.Text
  answer    String   @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("blog_post_faqs")
}

model BlogPostInternalLink {
  id        String   @id
  postId    String   @map("post_id")
  label     String
  href      String
  sortOrder Int      @default(0) @map("sort_order")
  isAuto    Boolean  @default(false) @map("is_auto")
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("blog_post_internal_links")
}

model BlogPostSeoAudit {
  id        String   @id
  postId    String   @map("post_id")
  passed    Boolean  @default(false)
  score     Int      @default(0)
  results   Json
  warnings  Json?
  errors    Json?
  createdAt DateTime @default(now()) @map("created_at")
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("blog_post_seo_audits")
}

model BlogPostRevision {
  id        String   @id
  postId    String   @map("post_id")
  snapshot  Json
  note      String?  @db.Text
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("blog_post_revisions")
}

model BlogPostAiDraft {
  id             String    @id
  postId         String?   @map("post_id")
  status         String    @default("pending")
  input          Json
  outputMarkdown String?   @map("output_markdown") @db.Text
  articleType    String?   @map("article_type")
  errorMessage   String?   @map("error_message") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  post           BlogPost? @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("blog_post_ai_drafts")
}

model ShortLink {
  id          String           @id
  slug        String           @unique
  targetUrl   String           @map("target_url") @db.Text
  title       String?
  description String?          @db.Text
  entityType  String?          @map("entity_type")
  entityId    String?          @map("entity_id")
  campaign    String?
  utmSource   String?          @map("utm_source")
  utmMedium   String?          @map("utm_medium")
  utmCampaign String?          @map("utm_campaign")
  isActive    Boolean          @default(true) @map("is_active")
  expiresAt   DateTime?        @map("expires_at")
  createdBy   String?          @map("created_by")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  clicks      ShortLinkClick[]

  @@index([entityType, entityId])
  @@index([isActive])
  @@map("short_links")
}

model ShortLinkClick {
  id          String    @id
  shortLinkId String    @map("short_link_id")
  ipHash      String?   @map("ip_hash")
  userAgent   String?   @map("user_agent") @db.Text
  device      String?
  browser     String?
  os          String?
  referer     String?   @db.Text
  utmSource   String?   @map("utm_source")
  utmMedium   String?   @map("utm_medium")
  utmCampaign String?   @map("utm_campaign")
  clickedAt   DateTime  @default(now()) @map("clicked_at")
  shortLink   ShortLink @relation(fields: [shortLinkId], references: [id], onDelete: Cascade)

  @@index([shortLinkId, clickedAt])
  @@map("short_link_clicks")
}

model FacebookPageConnection {
  id                   String   @id
  pageId               String   @unique @map("page_id")
  pageName             String?  @map("page_name")
  accessTokenEncrypted String   @map("access_token_encrypted") @db.Text
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("facebook_page_connections")
}

model FacebookContact {
  id             String   @id
  psid           String
  facebookUserId String?  @map("facebook_user_id")
  name           String?
  profilePic     String?  @map("profile_pic") @db.Text
  locale         String?
  timezone       Int?
  gender         String?
  tags           Json     @default("[]")
  firstSeenAt    DateTime @default(now()) @map("first_seen_at")
  lastSeenAt     DateTime @default(now()) @map("last_seen_at")
  leadId         String?  @map("lead_id")

  conversations FacebookConversation[]
  messages      FacebookMessage[]
  interactions  FacebookInteraction[]
  leads         Lead[]

  @@unique([psid])
  @@index([lastSeenAt])
  @@map("facebook_contacts")
}

model FacebookConversation {
  id             String    @id
  pageId         String    @map("page_id")
  contactId      String    @map("contact_id")
  channel        String
  threadKey      String    @map("thread_key")
  status         String    @default("open")
  lastMessageAt  DateTime? @map("last_message_at")
  lastInboundAt  DateTime? @map("last_inbound_at")
  lastOutboundAt DateTime? @map("last_outbound_at")
  assignedTo     String?   @map("assigned_to")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  contact  FacebookContact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages FacebookMessage[]

  @@unique([pageId, threadKey])
  @@index([pageId, status, lastMessageAt])
  @@index([contactId])
  @@map("facebook_conversations")
}

model FacebookMessage {
  id                String   @id
  conversationId    String   @map("conversation_id")
  contactId         String   @map("contact_id")
  direction         String
  messageType       String   @map("message_type")
  text              String?  @db.Text
  attachments       Json?
  facebookMessageId String?  @map("facebook_message_id")
  facebookCommentId String?  @map("facebook_comment_id")
  facebookPostId    String?  @map("facebook_post_id")
  rawPayload        Json?    @map("raw_payload")
  createdAt         DateTime @default(now()) @map("created_at")

  conversation FacebookConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contact      FacebookContact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([facebookMessageId])
  @@map("facebook_messages")
}

model FacebookInteraction {
  id              String   @id
  pageId          String   @map("page_id")
  contactId       String?  @map("contact_id")
  type            String
  postId          String?  @map("post_id")
  commentId       String?  @map("comment_id")
  text            String?  @db.Text
  status          String   @default("new")
  intentTags      Json?    @map("intent_tags")
  rawPayload      Json?    @map("raw_payload")
  canPrivateReply Boolean  @default(false) @map("can_private_reply")
  createdAt       DateTime @default(now()) @map("created_at")

  contact FacebookContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([pageId, type, createdAt])
  @@index([status])
  @@index([commentId])
  @@map("facebook_interactions")
}

model FacebookWebhookLog {
  id          String    @id
  object      String?
  entryCount  Int       @default(0) @map("entry_count")
  payload     Json
  processedAt DateTime? @map("processed_at")
  error       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("facebook_webhook_logs")
}

model FacebookWebhookEvent {
  id          String    @id
  object      String?
  payload     Json
  eventType   String?   @map("event_type")
  processed   Boolean   @default(false)
  error       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")

  @@index([createdAt])
  @@index([processed])
  @@map("facebook_webhook_events")
}

// --- AI Employee Platform (Prisma-native; not cms_records / dbHelper cache) ---

model AgentSource {
  id                  String    @id @default(cuid())
  companyId           String?   @map("company_id")
  name                String
  type                String
  url                 String    @db.Text
  status              String    @default("active")
  priority            Int       @default(5)
  scanIntervalMinutes Int       @default(60) @map("scan_interval_minutes")
  config              Json      @default("{}")
  checkpoint          Json?
  lastScannedAt       DateTime? @map("last_scanned_at")
  nextScanAt          DateTime? @map("next_scan_at")
  lastError           String?   @map("last_error") @db.Text
  /// Stable key for VPS upsert (company-scoped)
  externalSourceKey   String?   @map("external_source_key")
  syncStatus          String    @default("local_only") @map("sync_status")
  remoteId            String?   @map("remote_id")
  lastSyncAt          DateTime? @map("last_sync_at")
  syncError           String?   @map("sync_error") @db.Text
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  jobs            AgentJob[]
  scannedContents ScannedContent[]
  findings        AgentFinding[]
  missionLinks    AgentMissionSource[]
  workflowSteps   AgentWorkflowStepRun[]

  @@unique([companyId, url])
  @@unique([companyId, externalSourceKey])
  @@index([companyId])
  @@index([status, nextScanAt])
  @@index([priority])
  @@index([syncStatus])
  @@map("agent_sources")
}

model AgentMission {
  id              String    @id @default(cuid())
  companyId       String?   @map("company_id")
  ownerUserId     String?   @map("owner_user_id")
  name            String
  objective       String    @db.Text
  status          String    @default("draft")
  /// Legacy keyword / score config — kept for compatibility
  rules           Json      @default("{}")
  schedule        Json?
  /// Mission 2.0 versioned pipeline definition
  pipeline        Json?
  pipelineVersion Int       @default(1) @map("pipeline_version")
  templateKey     String?   @map("template_key")
  nextRunAt       DateTime? @map("next_run_at")
  lastRunAt       DateTime? @map("last_run_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  jobs           AgentJob[]
  findings       AgentFinding[]
  missionSources AgentMissionSource[]
  runs           AgentMissionRun[]
  workflowSteps  AgentWorkflowStepRun[]

  @@index([companyId])
  @@index([ownerUserId])
  @@index([status])
  @@index([status, nextRunAt])
  @@index([templateKey])
  @@map("agent_missions")
}

/// Many-to-many Mission ↔ Source
model AgentMissionSource {
  id        String   @id @default(cuid())
  companyId String?  @map("company_id")
  missionId String   @map("mission_id")
  sourceId  String   @map("source_id")
  isActive  Boolean  @default(true) @map("is_active")
  config    Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  mission AgentMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  source  AgentSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([missionId, sourceId])
  @@index([companyId])
  @@index([sourceId])
  @@index([missionId, isActive])
  @@map("agent_mission_sources")
}

model AgentMissionRun {
  id               String    @id @default(cuid())
  companyId        String?   @map("company_id")
  missionId        String    @map("mission_id")
  missionVersion   Int       @default(1) @map("mission_version")
  pipelineSnapshot Json      @map("pipeline_snapshot")
  pipelineHash     String?   @map("pipeline_hash")
  status           String    @default("queued")
  triggerType      String    @default("manual") @map("trigger_type")
  triggeredBy      String?   @map("triggered_by")
  startedAt        DateTime? @map("started_at")
  completedAt      DateTime? @map("completed_at")
  metrics          Json?
  error            String?   @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  mission AgentMission           @relation(fields: [missionId], references: [id], onDelete: Cascade)
  jobs    AgentJob[]
  steps   AgentWorkflowStepRun[]
  findings AgentFinding[]

  @@index([companyId])
  @@index([missionId, createdAt])
  @@index([missionId, status])
  @@index([status, createdAt])
  @@map("agent_mission_runs")
}

model AgentWorkflowStepRun {
  id               String    @id @default(cuid())
  companyId        String?   @map("company_id")
  missionRunId     String    @map("mission_run_id")
  missionId        String    @map("mission_id")
  jobId            String?   @map("job_id")
  sourceId         String?   @map("source_id")
  scannedContentId String?   @map("scanned_content_id")
  findingId        String?   @map("finding_id")
  stepId           String    @map("step_id")
  stepType         String    @map("step_type")
  status           String    @default("pending")
  attempts         Int       @default(0)
  maxAttempts      Int       @default(3) @map("max_attempts")
  idempotencyKey   String?   @map("idempotency_key")
  inputRef         Json?     @map("input_ref")
  output           Json?
  errorCode        String?   @map("error_code")
  errorMessage     String?   @map("error_message") @db.Text
  startedAt        DateTime? @map("started_at")
  completedAt      DateTime? @map("completed_at")
  durationMs       Int?      @map("duration_ms")
  createdAt        DateTime  @default(now()) @map("created_at")
