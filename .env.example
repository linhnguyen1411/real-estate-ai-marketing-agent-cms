# PostgreSQL native (không Docker)
# Sau setup: port 5432 (service) hoặc 5434 (cluster dev trong %LOCALAPPDATA%)
DATABASE_URL="postgresql://real_estate_ai:localdev@localhost:5434/real_estate_ai?schema=public"

# Setup:
#   npm run db:setup-local
#   npm run db:pg-start    # nếu dùng cluster port 5434
# Sync production:
#   npm run db:pull-and-sync

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"

# OPENAI_API_KEY: Used as ChatGPT fallback when Ollama local is unavailable.
OPENAI_API_KEY="MY_OPENAI_API_KEY"
OPENAI_MODEL="gpt-5-mini"

# Runtime server configuration.
PORT=3000
HOST="0.0.0.0"
JSON_BODY_LIMIT="25mb"

# AI provider defaults. The Settings screen can still switch provider at runtime.
DEFAULT_AI_MODE="auto"
OLLAMA_ENDPOINT="http://localhost:11434"
OLLAMA_MODEL="qwen3:8b"
OLLAMA_TIMEOUT_MS=45000
OPENAI_TIMEOUT_MS=60000

APP_URL="MY_APP_URL"

# Facebook Fanpage / Messenger (Phase 30)
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_VERIFY_TOKEN=""
FACEBOOK_PAGE_ID=""
FACEBOOK_PAGE_ACCESS_TOKEN=""
FACEBOOK_GRAPH_VERSION="v25.0"
# Optional: dedicated key for encrypting page tokens at rest (falls back to AUTH_SECRET)
FACEBOOK_TOKEN_ENCRYPTION_KEY=""

# AI Employee Platform (Sprint 1.1+ — feature flags only; not wired in code yet)
AGENT_ENABLED=false
AGENT_SCHEDULER_ENABLED=false

# Browser Worker (Sprint 3.1 — separate process, NOT started from server.ts)
AGENT_WORKER_ID=""
AGENT_BROWSER_PROFILE_DIR="data/browser-profiles/default"
AGENT_HEADLESS=true
AGENT_POLL_INTERVAL_MS=3000
AGENT_HEARTBEAT_INTERVAL_MS=20000
# Optional: scope BrowserSession to a company tenant
AGENT_COMPANY_ID=""
AGENT_SESSION_NAME=""
# Login helper start URL (headed browser only)
AGENT_LOGIN_START_URL="https://www.facebook.com/"

# Lead analysis (Sprint 4.1)
AGENT_LEAD_ANALYSIS_MAX_CHARS=4000
AGENT_LEAD_ANALYSIS_MAX_PER_JOB=10
AGENT_LEAD_ANALYSIS_TIMEOUT_MS=45000
# Set to 1 in tests to force deterministic fallback (no AI API calls)
AGENT_LEAD_ANALYSIS_SKIP_AI=""

# Facebook reader debug (Sprint 5.1 — never commit artifacts)
AGENT_FB_DEBUG_SCREENSHOTS=""
AGENT_FB_DEBUG_TRACES=""
