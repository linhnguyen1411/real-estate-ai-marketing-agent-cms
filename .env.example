# PostgreSQL native (không Docker)
# Sau setup: port 5432 (service) hoặc 5434 (cluster dev trong %LOCALAPPDATA%)
DATABASE_URL="postgresql://real_estate_ai:localdev@localhost:5434/real_estate_ai?schema=public"

# Setup:
#   npm run db:setup-local
#   npm run db:pg-start    # nếu dùng cluster port 5434
# Sync production:
#   npm run db:pull-and-sync

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"

# OPENAI_API_KEY: Used as ChatGPT fallback when Ollama local is unavailable.
OPENAI_API_KEY="MY_OPENAI_API_KEY"
OPENAI_MODEL="gpt-5-mini"

# Runtime server configuration.
PORT=3000
HOST="0.0.0.0"
JSON_BODY_LIMIT="25mb"

# AI provider defaults. The Settings screen can still switch provider at runtime.
DEFAULT_AI_MODE="auto"
OLLAMA_ENDPOINT="http://localhost:11434"
OLLAMA_MODEL="qwen3:8b"
OLLAMA_TIMEOUT_MS=45000
OPENAI_TIMEOUT_MS=60000

APP_URL="MY_APP_URL"

# Facebook Fanpage / Messenger (Phase 30)
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_VERIFY_TOKEN=""
FACEBOOK_PAGE_ID=""
FACEBOOK_PAGE_ACCESS_TOKEN=""
FACEBOOK_GRAPH_VERSION="v25.0"
# Optional: dedicated key for encrypting page tokens at rest (falls back to AUTH_SECRET)
FACEBOOK_TOKEN_ENCRYPTION_KEY=""

# Social Publishing MVP (AI Agent → Lịch đăng bài)
# Feature gate for routes/worker (optional; module registers when server boots today).
SOCIAL_PUBLISHING_ENABLED=true
# When 1, browser/graph publishers skip live Facebook and return dry_run results.
SOCIAL_PUBLISH_DRY_RUN=0
# Browser mission publish: set to 1 for live Facebook posts (default dry-run if unset)
# BROWSER_PUBLISH_LIVE=1

# AI Employee Platform
AGENT_ENABLED=false
# Scheduler: enqueue scan_source jobs only (no browser). Requires DB.
AGENT_SCHEDULER_ENABLED=false
# VPS ingest API (HMAC). Stage A of production rollout.
AGENT_INGEST_ENABLED=false
# Telegram auto-notify — hardcoded ON in notifyFindingIfEligible (compat flag).
AGENT_TELEGRAM_ENABLED=true

# Telegram Control Plane Console (inbound bot)
# TELEGRAM_CONSOLE_ENABLED=1
# TELEGRAM_CONSOLE_MODE=polling
# TELEGRAM_ALLOWED_USER_IDS=123456789
# TELEGRAM_ALLOWED_CHAT_IDS=-1001234567890
# TELEGRAM_ADMIN_USER_IDS=123456789
# TELEGRAM_WEBHOOK_SECRET=change-me
# TELEGRAM_POLL_INTERVAL_MS=2500
# TELEGRAM_EVENT_NOTIFY_MS=15000
# TELEGRAM_RATE_LIMIT_PER_MIN=20
# Local→VPS outbox sync — hardcoded ON in isLocalSyncEnabled (compat flag).
AGENT_LOCAL_SYNC_ENABLED=true
# AGENT_LOCAL_SYNC_INTERVAL_MS=15000
# Optional overrides if not using CMS Settings:
# AGENT_SYNC_VPS_URL=https://bdsdanang.site
# AGENT_SYNC_KEY_ID=
# AGENT_SYNC_SECRET=
# AGENT_SYNC_WORKER_ID=local-worker-1
# AGENT_SYNC_BATCH_SIZE=10
# Keep Graph Page webhook routes (do not disable if production webhook is live).
FACEBOOK_GRAPH_LEGACY_ENABLED=true
AGENT_INGEST_TIMESTAMP_SKEW_SECONDS=300
AGENT_INGEST_NONCE_TTL_MS=600000

# Browser Worker (separate process — npm run agent:worker)
AGENT_WORKER_ID=""
# managed = launchPersistentContext (public websites)
# cdp = attach to user-opened Chrome (Facebook) — see docs/AI-AGENT-BROWSER-MODES.md
AGENT_BROWSER_MODE=managed
# Dedicated agent profile (path.resolve). NEVER your personal Chrome User Data dir.
AGENT_BROWSER_PROFILE_DIR="./runtime/agent-browser-profile"
# Only used when AGENT_BROWSER_MODE=managed. Prefer false for interactive sessions.
AGENT_HEADLESS=false
# CDP (Facebook): only loopback allowed
AGENT_CDP_ENDPOINT=http://127.0.0.1:9222
AGENT_POLL_INTERVAL_MS=3000
AGENT_HEARTBEAT_INTERVAL_MS=20000
AGENT_COMPANY_ID=""
AGENT_SESSION_NAME=""
# Managed login start URL (npm run agent:login) — no autofill
AGENT_LOGIN_START_URL="https://www.facebook.com/"

# Lead analysis (Sprint 4.1)
AGENT_LEAD_ANALYSIS_MAX_CHARS=4000
AGENT_LEAD_ANALYSIS_MAX_PER_JOB=10
AGENT_LEAD_ANALYSIS_TIMEOUT_MS=45000
AGENT_LEAD_ANALYSIS_SKIP_AI=""
# hybrid | ai_first | keyword_only — keyword is NOT a hard gate except keyword_only
AGENT_ANALYSIS_MODE="hybrid"

# Facebook reader debug (never commit artifacts)
AGENT_FB_DEBUG_SCREENSHOTS=""
AGENT_FB_DEBUG_TRACES=""
