    "test:agent-regression": "node scripts/test-agent-regression.mjs",
    "test:deploy-safety": "node scripts/test-deploy-safety.mjs",
    "test:agent-tenant-isolation": "tsx scripts/test-agent-tenant-isolation.ts",
    "fb:test": "tsx scripts/fb-test.mjs",
    "clean": "rm -rf dist server.cjs",
    "lint": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@prisma/client": "^5.22.0",
    "@tailwindcss/vite": "^4.1.14",
