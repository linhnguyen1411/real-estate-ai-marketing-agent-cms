    "audit:content": "tsx scripts/audit-content.ts",
    "preview": "vite preview",
    "analyze": "ANALYZE=true npm run build",
    "check:assets": "node scripts/check-assets.mjs",
    "test:facebook-webhook": "tsx scripts/test-facebook-webhook.mjs",
    "test:agent-api": "node scripts/test-agent-api.mjs",
    "test:website-reader": "tsx scripts/test-website-reader.mjs",
    "test:lead-analyzer": "tsx scripts/test-lead-analyzer.mjs",
    "test:lead-pipeline": "tsx scripts/test-lead-pipeline.mjs",
