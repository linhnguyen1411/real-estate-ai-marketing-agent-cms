{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/free-dev-ports.mjs && node scripts/ensure-local-pg.mjs && tsx server.ts",
    "dev:restart": "node scripts/free-dev-ports.mjs && node scripts/ensure-local-pg.mjs && tsx server.ts",
    "build": "prisma generate && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node scripts/start-production.cjs",
    "deploy": "powershell -ExecutionPolicy Bypass -File scripts/deploy.ps1",
    "deploy:safe": "powershell -ExecutionPolicy Bypass -File scripts/deploy-safe.ps1",
    "backup:prod": "powershell -ExecutionPolicy Bypass -File scripts/backup-prod.ps1",
    "db:setup-local": "powershell -ExecutionPolicy Bypass -File scripts/setup-local-db.ps1",
    "db:pg-start": "powershell -ExecutionPolicy Bypass -File scripts/pg-cluster.ps1 -Action start",
    "db:pg-stop": "powershell -ExecutionPolicy Bypass -File scripts/pg-cluster.ps1 -Action stop",
    "db:pull-prod": "powershell -ExecutionPolicy Bypass -File scripts/pull-prod-db.ps1",
    "db:sync-prod": "node scripts/sync-prod-db.mjs",
    "db:pull-and-sync": "npm run db:pull-prod && npm run db:setup-local && npm run prisma:push && npm run db:sync-prod",
    "db:bootstrap-vps": "powershell -ExecutionPolicy Bypass -File scripts/bootstrap-vps-db.ps1",
    "preview": "vite preview",
    "analyze": "ANALYZE=true npm run build",
    "agent:worker": "tsx server/agent-worker/index.ts",
    "automation-agent": "tsx server/automation-agent/index.ts",
    "automation-cli": "tsx scripts/automation-cli.ts",
    "agent:login": "tsx server/agent-worker/login.ts",
    "agent:check-facebook-session": "tsx scripts/check-facebook-session.ts",
    "agent:install-browser": "playwright install chromium",
    "agent:diagnose-runtime": "node scripts/diagnose-agent-runtime.mjs",
    "cleanup:agent-runtime": "node scripts/cleanup-agent-runtime.mjs",
    "cleanup:db-tech-retention": "node scripts/cleanup-db-tech-retention.mjs",
    "test:deploy-safety": "node scripts/test-deploy-safety.mjs",
    "clean": "rm -rf dist server.cjs",
    "lint": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@prisma/client": "^5.22.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.546.0",
    "marked": "^18.0.5",
    "pg": "^8.21.0",
    "playwright": "^1.62.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.11.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.10",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "prisma": "^5.22.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
