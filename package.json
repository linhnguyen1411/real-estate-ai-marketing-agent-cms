{
  "name": "real-estate-ai-marketing-agent-cms",
  "description": "Production-grade Real Estate AI Marketing Agent & Multi-tenant CMS",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node scripts/free-dev-ports.mjs && node scripts/ensure-local-pg.mjs && tsx server.ts",
    "dev:restart": "node scripts/free-dev-ports.mjs && node scripts/ensure-local-pg.mjs && tsx server.ts",
    "build": "prisma generate && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node scripts/start-production.cjs",
    "deploy": "powershell -ExecutionPolicy Bypass -File scripts/deploy.ps1",
    "deploy:safe": "powershell -ExecutionPolicy Bypass -File scripts/deploy-safe.ps1",
    "backup:prod": "powershell -ExecutionPolicy Bypass -File scripts/backup-prod.ps1",
    "db:setup-local": "powershell -ExecutionPolicy Bypass -File scripts/setup-local-db.ps1",
    "db:pg-start": "powershell -ExecutionPolicy Bypass -File scripts/pg-cluster.ps1 -Action start",
    "db:pg-stop": "powershell -ExecutionPolicy Bypass -File scripts/pg-cluster.ps1 -Action stop",
    "db:pull-prod": "powershell -ExecutionPolicy Bypass -File scripts/pull-prod-db.ps1",
    "db:sync-prod": "node scripts/sync-prod-db.mjs",
    "db:bootstrap-vps": "powershell -ExecutionPolicy Bypass -File scripts/bootstrap-vps-db.ps1",
    "db:sync-master-plan": "node scripts/ensure-master-plan-db.mjs",
    "preview": "vite preview",
    "analyze": "ANALYZE=true npm run build",
    "agent:worker": "tsx server/agent-worker/index.ts",
    "build:desktop": "node desktop/build.mjs",
    "build:installer": "node scripts/build-installer.mjs",
    "dev:desktop": "node desktop/build.mjs && electron desktop/dist/main/index.cjs",
    "local:watchdog": "powershell -ExecutionPolicy Bypass -File scripts/local/watchdog-local.ps1",
    "local:watchdog:install": "powershell -ExecutionPolicy Bypass -File scripts/local/register-watchdog-task.ps1",
    "local:watchdog:install:lean": "powershell -ExecutionPolicy Bypass -File scripts/local/register-watchdog-task.ps1 -LeanMode",
    "local:watchdog:stop": "powershell -ExecutionPolicy Bypass -File scripts/local/stop-watchdog.ps1",
    "local:watchdog:uninstall": "powershell -ExecutionPolicy Bypass -File scripts/local/stop-watchdog.ps1 -UnregisterTask",
    "automation-agent": "tsx server/automation-agent/index.ts",
    "automation-cli": "tsx scripts/automation-cli.ts",
    "agent:login": "tsx server/agent-worker/login.ts",
    "agent:check-facebook-session": "tsx scripts/check-facebook-session.ts",
    "agent:install-browser": "playwright install chromium",
    "agent:diagnose-runtime": "node scripts/diagnose-agent-runtime.mjs",
    "cleanup:agent-runtime": "node scripts/cleanup-agent-runtime.mjs",
    "cleanup:db-tech-retention": "node scripts/cleanup-db-tech-retention.mjs",
    "test:deploy-safety": "node scripts/test-deploy-safety.mjs",
    "clean": "rm -rf dist server.cjs",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:security": "vitest run tests/security/",
    "test:baseline": "vitest run tests/baseline/",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage.enabled=false",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@prisma/client": "^7.10.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.1.2",
    "argon2": "^0.45.1",
    "compression": "^1.8.2",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "gray-matter": "^4.0.3",
    "helmet": "^8.3.0",
    "lucide-react": "^1.61.0",
    "marked": "^18.1.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.18.1",
    "vite": "^8.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.6.1",
    "electron": "^45.0.0",
    "esbuild": "^0.28.2",
    "prisma": "^7.10.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  }
}
