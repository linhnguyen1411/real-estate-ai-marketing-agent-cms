    "test:real-estate-domain-gate": "tsx scripts/test-real-estate-domain-gate.mjs",
    "test:lead-intelligence-resolver": "tsx scripts/test-lead-intelligence-resolver.ts",
    "test:finding-structured-data": "tsx scripts/test-finding-structured-data.ts",
    "test:finding-promotion": "tsx scripts/test-finding-promotion.ts",
    "test:external-inventory": "tsx scripts/test-external-inventory.ts",
    "test:finding-matching": "tsx scripts/test-finding-matching.ts",
    "test:investor-lead-conversion": "tsx scripts/test-investor-lead-conversion.ts",
